; Foxtopia — Godot 4 project
config_version=5

[application]

config/name="Foxtopia"
config/icon="res://assets/foxtopia_mark.svg"
config/windows_native_icon="res://assets/foxtopia.ico"
config/version="0.1.10.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="A small colony simulation about people building a home together."

[autoload]

Game="*res://scripts/model/game_model.gd"
Net="*res://scripts/net/network_bridge.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.071, 0.103, 0.103, 1)

[gui]

theme/default_font_size=16
