static func t(key: String, locale: String = "en", values: Dictionary = {}) -> String:
	var table: Dictionary = ENGLISH
	match normalize_locale(locale):
		"tr": table = TURKISH
		"pl": table = POLISH
	var message: String = str(table.get(key, ENGLISH.get(key, key)))
	return message.format(values) if not values.is_empty() else message


static func normalize_locale(locale: String) -> String:
	var short_code := locale.to_lower().replace("_", "-").split("-")[0]
	return short_code if short_code in ["en", "tr", "pl"] else "en"


static func language_options() -> Array[Dictionary]:
	return [
		{"id": "en", "label": "English"},
		{"id": "tr", "label": "Türkçe"},
		{"id": "pl", "label": "Polski"},
	]


static func missing_keys(locale: String) -> Array[String]:
	var table: Dictionary = ENGLISH
	match normalize_locale(locale):
		"tr": table = TURKISH
		"pl": table = POLISH
	var missing: Array[String] = []
	for key in ENGLISH:
		if not table.has(key):
			missing.append(str(key))
	return missing
