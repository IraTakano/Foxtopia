	var names := {
		"Tarım": ["Farming", "Rolnictwo"], "İlk Yardım": ["First Aid", "Pierwsza pomoc"],
		"Taş İşçiliği": ["Stonework", "Obróbka kamienia"], "Barikat": ["Barriers", "Barykady"],
